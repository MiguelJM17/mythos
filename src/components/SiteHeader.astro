---
import { href } from '../lib/site';
import { currentIssue, nextIssue } from '../data/issues';
const path = Astro.url.pathname;
const links = [
  { to: `issues/${currentIssue.id}`, label: `Issue ${currentIssue.numeral}`, match: `/issues/${currentIssue.id}` },
  ...(nextIssue ? [{ to: `issues/${nextIssue.id}`, label: `Issue ${nextIssue.numeral}`, match: `/issues/${nextIssue.id}` }] : []),
  { to: 'about', label: 'About', match: '/about' },
  { to: 'submit', label: 'Submit', match: '/submit' },
];
const isActive = (m: string) => {
  const p = path.replace(/\.html$/, '');
  if (nextIssue && m === `/issues/${nextIssue.id}` && p.startsWith('/discussions/')) return true;
  return p === m || p.startsWith(m + '/');
};
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="wordmark" href={href('', path)} aria-label="Mythos, home">
      <span class="wordmark__name">Mythos</span><span class="wordmark__dot" aria-hidden="true"></span>
      <span class="wordmark__greek" lang="grc" aria-hidden="true">μῦθος</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav">
        {links.map((l) => (
          <li>
            <a href={href(l.to, path)} aria-current={isActive(l.match) ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
        <li>
          <button class="theme-toggle" type="button" aria-pressed="false" data-theme-toggle>
            <span class="visually-hidden">Dark mode</span>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const sync = () => btn?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  sync();
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('mythos-theme', next); } catch {}
    sync();
  });
</script>

<style>
  .site-header { border-bottom: 1px solid var(--rule); }
  .site-header__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1rem; min-height: 4.25rem; flex-wrap: wrap; padding-block: .5rem;
  }
  .wordmark {
    display: inline-flex; align-items: baseline; gap: .1rem;
    color: var(--ink); text-decoration: none;
  }
  .wordmark__name {
    font-family: var(--serif); font-style: italic; font-weight: 500;
    font-size: clamp(1.7rem, 1.4rem + 1vw, 2.1rem); letter-spacing: -0.02em; line-height: 1;
  }
  .wordmark__dot {
    width: .38rem; height: .38rem; border-radius: 50%;
    background: var(--orange); margin-left: .12rem; align-self: flex-end; margin-bottom: .35rem;
  }
  .wordmark__greek {
    font-family: var(--serif); font-size: .95rem; color: var(--ink-2);
    margin-left: .55rem; font-style: italic;
  }
  .nav {
    list-style: none; margin: 0; padding: 0;
    display: flex; align-items: center; gap: clamp(.9rem, 2.5vw, 2rem);
    font-family: var(--sans); font-size: .95rem; font-weight: 500;
  }
  .nav a {
    color: var(--ink); text-decoration: none; padding-block: .6rem;
    border-bottom: 2px solid transparent;
  }
  .nav a:hover { color: var(--blue); }
  .nav a[aria-current='page'] { border-bottom-color: var(--orange); }
  .theme-toggle {
    display: grid; place-items: center; width: 44px; height: 44px; margin-right: -10px;
    background: none; border: 0; color: var(--ink-2); cursor: pointer; border-radius: 50%;
  }
  .theme-toggle:hover { color: var(--ink); background: var(--paper-2); }
  .i-sun { display: none; }
  :global([data-theme='dark']) .i-sun { display: block; }
  :global([data-theme='dark']) .i-moon { display: none; }
  @media (max-width: 30rem) {
    .wordmark__greek { display: none; }
    .site-header__inner { row-gap: 0; padding-bottom: 0; }
    nav { flex-basis: 100%; }
    .nav { justify-content: space-between; gap: .5rem; font-size: .92rem; border-top: 1px solid var(--rule); margin-top: .35rem; }
    .theme-toggle { width: 40px; height: 40px; margin-right: -8px; }
  }
</style>
