---
import Base from '../layouts/Base.astro';
import { currentIssue, nextIssue } from '../data/issues';
import { href } from '../lib/site';

const path = Astro.url.pathname;
const doors = [
  { to: `issues/${currentIssue.id}`, kicker: `Issue ${currentIssue.numeral}`, title: currentIssue.theme, text: 'Read the first issue.' },
  ...(nextIssue ? [{ to: `issues/${nextIssue.id}`, kicker: `Issue ${nextIssue.numeral} · Coming next`, title: nextIssue.theme, text: 'Discussions under every piece.' }] : []),
  { to: 'submit', kicker: 'Submit', title: 'Send your work', text: 'Philosophic papers and literary work.' },
];
---
<Base>
  <section class="cover wrap" aria-labelledby="mission">
    <div class="cover__main">
      <h1 id="mission" class="cover__title">
        Philosophy and literature from the students who write it.
      </h1>
      <p class="cover__sub">
        A student journal born in the philosophy classrooms of Miami Dade College.
      </p>
    </div>

    <nav class="doors" aria-label="Enter Mythos">
      {doors.map((d) => (
        <a class="door" href={href(d.to, path)}>
          <span class="door__kicker label">{d.kicker}</span>
          <span class="door__title">{d.title} <span class="door__arrow" aria-hidden="true">→</span></span>
          <span class="door__text">{d.text}</span>
        </a>
      ))}
    </nav>
  </section>
</Base>

<style>
  .cover {
    min-height: calc(100svh - 6.5rem);
    display: flex; flex-direction: column; justify-content: space-between;
    gap: clamp(2.5rem, 6vw, 4rem);
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(1.5rem, 4vh, 2.5rem);
  }
  .cover__main { margin-block: auto; }
  .cover__title {
    font-size: clamp(2.75rem, 1.6rem + 4.4vw, 5.5rem);
    font-weight: 400; line-height: 1.02; letter-spacing: -0.025em; max-width: 15ch;
  }
  .cover__sub { margin: 1.5rem 0 0; max-width: 36rem; color: var(--ink-2); font-size: 1.15em; line-height: 1.5; }

  .doors { display: grid; border-top: 2px solid var(--ink); }
  .door {
    display: grid; align-content: start; gap: .3rem; padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule); color: inherit; text-decoration: none;
  }
  .door__kicker { color: var(--orange-text); font-weight: 600; }
  .door__title { font-family: var(--display); font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); line-height: 1.1; }
  .door__text { color: var(--ink-2); font-size: 1rem; }
  .door__arrow { display: inline-block; font-family: var(--sans); font-size: .75em; color: var(--blue); transition: translate .15s ease; }
  .door:hover .door__title { color: var(--blue); }
  .door:hover .door__arrow { translate: 4px 0; }

  @media (min-width: 60rem) {
    .doors { grid-template-columns: repeat(3, 1fr); }
    .door { border-bottom: 0; padding: 1.4rem 1.5rem 0 0; }
    .door + .door { border-left: 1px solid var(--rule); padding-left: 1.75rem; }
  }
</style>
